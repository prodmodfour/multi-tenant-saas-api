# Public-safe local placeholder configuration.
# Copy to an untracked .env file for local experimentation only.
# Never commit real secrets or production credentials.

SAAS_API_APP_NAME=multi-tenant-saas-api
SAAS_API_APP_VERSION=0.1.0
SAAS_API_ENVIRONMENT=local
SAAS_API_LOG_LEVEL=INFO
SAAS_API_DOCS_ENABLED=true
SAAS_API_DATABASE_URL=postgresql+asyncpg://saas_api:saas_api@localhost:5432/saas_api
SAAS_API_JWT_SECRET=local-placeholder-jwt-secret-not-for-production
SAAS_API_JWT_ISSUER=multi-tenant-saas-api-local
SAAS_API_ACCESS_TOKEN_TTL_SECONDS=900
SAAS_API_PASSWORD_MIN_LENGTH=12
